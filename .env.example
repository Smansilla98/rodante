APP_NAME="Rodante"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8093

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=trazabilidad
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Password reset: "log" escribe el enlace en storage/logs/laravel.log.
# En producción reemplazar por smtp/resend y configurar host, puerto y credenciales.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="flota@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Restablecimiento por correo (default off: en prod el mail no sale con MAIL_MAILER=log).
RODANTE_PASSWORD_RESET_ENABLED=false
# Content-Security-Policy en modo enforce (false = Report-Only).
RODANTE_CSP_ENFORCE=true

VITE_APP_NAME="${APP_NAME}"

# Predictivo: sin clave se usa el cálculo local (mm / km). Con clave, se pide una narrativa al proveedor compatible con OpenAI.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Producción en Railway: ver .env.railway + scripts/railway-db-setup.sh (MySQL recomendado; PostgreSQL opcional).
# -----------------------------------------------------------------------------
