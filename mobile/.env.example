# Rodante Mobile (Expo)

# URL base de la API (incluye /api/v1).
#
# - Probando con Expo Go en un CELULAR FÍSICO: 127.0.0.1 apunta al celular, no
#   a tu compu — usá la IP LAN de tu máquina (mismo WiFi que el celular) y el
#   puerto 8093, que es el que expone `docker compose up` (ver docker-compose.yml
#   → servicio nginx). Para encontrar tu IP LAN: `hostname -I` (Linux) o
#   `ipconfig getifaddr en0` (Mac).
# - Emulador Android: 10.0.2.2 es el alias especial que apunta a tu compu desde
#   el emulador (no 127.0.0.1). Puerto sigue siendo 8093.
# - Simulador iOS: 127.0.0.1 sí funciona (comparte red con el Mac host).
EXPO_PUBLIC_API_URL=http://192.168.0.X:8093/api/v1

# Producción (Railway): https://rodant-production.up.railway.app/api/v1

# development | staging | production
APP_ENV=development

# Ya no hace falta — el proyecto EAS real (d44353e5-8326-4445-a9ea-06d914decb2e)
# ya está cargado en app.config.ts. Esta variable solo sirve para overridearlo
# puntualmente (por ejemplo, para apuntar a un proyecto EAS distinto).
EAS_PROJECT_ID=
