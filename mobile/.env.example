# Rodante Mobile (Expo)

# URL base de la API (incluye /api/v1). Para desarrollo local usá tu IP LAN, ej: http://192.168.0.X:8000/api/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Producción (Railway): https://rodant-production.up.railway.app/api/v1

# development | staging | production
APP_ENV=development

# TODO: no existe todavía un proyecto EAS real.
# Correr `eas init` para generar el projectId real y pegarlo acá / en EAS secrets.
EAS_PROJECT_ID=
