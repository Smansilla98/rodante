FROM php:8.3-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip libzip-dev libonig-dev libsqlite3-dev libpq-dev \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev \
    nginx supervisor default-mysql-client \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql pdo_pgsql pdo_sqlite zip opcache mbstring bcmath \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

COPY docker/nginx/railway.conf.template /etc/nginx/templates/rodante.conf.template
COPY docker/supervisor/rodante.conf /etc/supervisor/conf.d/rodante.conf
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/log/supervisor

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]

