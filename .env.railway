# =============================================================================
# Variables para Railway (producción) — Rodante
# =============================================================================
# Cómo usarlo:
# 1. En Railway: creá el servicio de la app + un plugin de base de datos.
# 2. Variables → Raw Editor → pegá este archivo (o cargá variable por variable).
# 3. Completá APP_KEY y APP_URL (ver notas abajo).
# 4. Release Command del servicio web:
#      bash scripts/railway-db-setup.sh
#    Ese script detecta MySQL o PostgreSQL, migra y carga la demo.
#
# Motor del producto (recomendado): MySQL 8
# Alternativa: PostgreSQL (mismo schema Laravel; el script setea DB_CONNECTION=pgsql)
#
# Generar APP_KEY en local:
#   php artisan key:generate --show
# =============================================================================

APP_NAME="Rodante"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-SERVICIO.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Base de datos -----------------------------------------------------------
# Opción A — MySQL (recomendado; plugin MySQL de Railway)
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

# Si DB_URL no te funciona con MySQL, descomentá el desglose:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Opción B — PostgreSQL (plugin Postgres de Railway)
# Comentá el bloque MySQL de arriba y usá:
# DB_CONNECTION=pgsql
# DB_URL=${{Postgres.DATABASE_URL}}
# # o desglose:
# # DB_HOST=${{Postgres.PGHOST}}
# # DB_PORT=${{Postgres.PGPORT}}
# # DB_DATABASE=${{Postgres.PGDATABASE}}
# # DB_USERNAME=${{Postgres.PGUSER}}
# # DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Demo online: el release script hace seed si SEED_DEMO=1.
# En producción real dejalo en 0 (o no lo definas y cambiá el script).
SEED_DEMO=0

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# "log" no envía correos: sirve para validar reset mirando logs.
# Para usuarios reales usar smtp/resend y agregar sus credenciales en Railway.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@TU-DOMINIO.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Railway expone el puerto en PORT (el runtime lo usa; Laravel no lo necesita
# si servís con nginx/frankenphp/octane según tu Dockerfile).
# PORT=8080
