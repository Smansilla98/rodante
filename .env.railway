# =============================================================================
# Variables para Railway (producción) — Rodanta
# =============================================================================
# Cómo usarlo:
# 1. En Railway: creá el servicio de la app + el plugin MySQL.
# 2. Variables → Raw Editor → pegá este archivo (o cargá variable por variable).
# 3. Completá APP_KEY y APP_URL (ver notas abajo).
# 4. Las variables ${{MySQL.*}} las resuelve Railway al conectar el plugin MySQL.
#
# Generar APP_KEY en local:
#   php artisan key:generate --show
# =============================================================================

APP_NAME="Rodanta"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-SERVICIO.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (plugin MySQL de Railway) -----------------------------------------
# Preferí DB_URL: Railway inyecta MYSQL_URL / DATABASE_URL al vincular MySQL.
DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

# Si DB_URL no te funciona, descomentá y usá el desglose:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@TU-DOMINIO.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Railway expone el puerto en PORT (el runtime lo usa; Laravel no lo necesita
# si servís con nginx/frankenphp/octane según tu Dockerfile).
# PORT=8080
